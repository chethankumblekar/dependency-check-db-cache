# Optional. An OAuth app only signs a person in.
# Leave these unset to sign in on localhost without them.
# Remote sign-in ignores the Host header. Set the origin clients actually use:
# CHECKSTEAD_PUBLIC_BASE=https://checkstead.example
# The server answers only to loopback names and the CHECKSTEAD_PUBLIC_BASE
# host. Other names it should answer to, comma separated:
# CHECKSTEAD_ALLOWED_HOSTS=checkstead.internal.example
# Behind a TLS proxy, mark cookies Secure and send HSTS:
# CHECKSTEAD_COOKIE_SECURE=1
CHECKSTEAD_GITHUB_CLIENT_ID=
CHECKSTEAD_GITHUB_CLIENT_SECRET=

# Optional. Microsoft Entra sign-in. Leave these unset when you are not using it.
CHECKSTEAD_ENTRA_CLIENT_ID=
CHECKSTEAD_ENTRA_CLIENT_SECRET=
CHECKSTEAD_ENTRA_TENANT=
# With CHECKSTEAD_ENTRA_TENANT=organizations, the directory ids that may sign in:
CHECKSTEAD_ENTRA_ALLOWED_TENANTS=
# Optional. Security group object ids that sign in without being added by hand.
# The app registration must emit groups: groupMembershipClaims = SecurityGroup.
CHECKSTEAD_ENTRA_ALLOWED_GROUPS=
CHECKSTEAD_ENTRA_ADMIN_GROUPS=

# Optional. An Azure DevOps organization whose repositories, branches, and
# Checkstead pipeline runs the server syncs. The Entra app above signs in as
# itself; an organization administrator adds it as a user with project Reader.
# CHECKSTEAD_ENTRA_TENANT must then be a tenant id.
CHECKSTEAD_AZURE_DEVOPS_ORG=
# Comma-separated project names. Empty means every project the app can read.
CHECKSTEAD_AZURE_DEVOPS_PROJECTS=
# Pipelines whose name matches this are listed as Checkstead runs.
# CHECKSTEAD_AZURE_DEVOPS_PIPELINES=*checkstead*
# A separate Entra application for the sync. Each defaults to its
# CHECKSTEAD_ENTRA_* value above.
# CHECKSTEAD_AZURE_DEVOPS_CLIENT_ID=
# CHECKSTEAD_AZURE_DEVOPS_CLIENT_SECRET=
# CHECKSTEAD_AZURE_DEVOPS_TENANT=
# Minutes between syncs. 0 syncs only when an administrator asks.
# CHECKSTEAD_SYNC_MINUTES=15
