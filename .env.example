# Optional. An OAuth app only signs a person in.
# Leave these unset to sign in on localhost without them.
# Remote sign-in ignores the Host header. Set the origin clients actually use:
# CHECKSTEAD_PUBLIC_BASE=https://checkstead.example
CHECKSTEAD_GITHUB_CLIENT_ID=
CHECKSTEAD_GITHUB_CLIENT_SECRET=

# Optional. Microsoft Entra sign-in. Leave these unset when you are not using it.
CHECKSTEAD_ENTRA_CLIENT_ID=
CHECKSTEAD_ENTRA_CLIENT_SECRET=
CHECKSTEAD_ENTRA_TENANT=
