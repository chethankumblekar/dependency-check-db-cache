{
  "name": "checkstead-web",
  "private": true,
  "description": "Development tooling for the Checkstead web UI. Nothing here ships in the Python package except the vendored font files.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22.22.2" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "vendor-fonts": "node scripts/vendor-fonts.mjs"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2"
  }
}
